<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>{{ title }} | WHMIS Wise Training & Certification</title>

  <meta
    name="description"
    content="WHMIS Wise provides comprehensive, easy-to-use online WHMIS training and certification. Get workplace-compliant with our specialized Foundational, Pharmacy, and Dental courses."
  />
  <meta
    name="keywords"
    content="WHMIS training, online WHMIS certification, workplace safety Canada, WHMIS 2015, GHS compliance, dental WHMIS, pharmacy WHMIS, occupational health and safety"
  />
  <meta name="author" content="WHMIS Wise" />
  <meta name="robots" content="index, follow" />
  <meta name="revisit-after" content="7 days" />
  <meta name="language" content="English" />
  
  <meta property="og:title" content="{{ title }} | WHMIS Wise" />
  <meta property="og:description" content="Get certified today with our professional online WHMIS training for workplaces, pharmacies, and dental clinics." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://whmiswise.com/" />
  <meta property="og:image" content="https://whmiswise.com/assets/whmiswise-logo.png" />
  <meta property="og:site_name" content="WHMIS Wise" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "WHMIS Wise",
    "url": "https://whmiswise.com",
    "logo": "https://whmiswise.com/assets/WW.png",
    "description": "Professional online WHMIS training and workplace safety certification.",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "CA"
    },
    "offers": {
      "@type": "Offer",
      "category": "Educational Occupational Training"
    }
  }
  </script>

  <link rel="stylesheet" href="https://startr.style/style.css" />
    
  <style>
    :root {
      --oklch-light-green: oklch(80%, 0.15, 145);
      --oklch-dark-green: oklch(45%, 0.2, 145);
      --oklch-light-blue: oklch(80%, 0.14, 250);
      --oklch-dark-blue: oklch(15%, 0.2, 250);
      --oklch-light-brown: oklch(60%, 0.25, 70);
      --oklch-dark-brown: oklch(30%, 0.35, 70);
      --oklch-light-yellow: oklch(95%, 0.1, 100);
      --oklch-dark-yellow: oklch(75%, 0.22, 90);
      --oklch-light-gray: oklch(90%, 0.01, 0);
      --oklch-dark-gray: oklch(20%, 0+5, 150);
    }
    
    @font-face {
      font-family: 'AR Custom'; 
      src: url('/assets/ar.otf') format('opentype');
      font-weight: normal;
      font-style: normal;
    }
    
    body {  
      font-weight: 300 !important;
    }

    /* Fixed Global Background */
    body::before {
      content: "";
      position: fixed; 
      top: 0;
      left: 0;
      right: 0;  
      bottom: 0; 
      z-index: -1; 
      background: url('/assets/originalG77.png') no-repeat center center;
      background-size: cover;
      margin: 0;
      padding: 0;
    }

    .coming-soon {
      flex: 1; 
      padding: 10px;
      text-align: center;
      color: black;
    }
      
    .info-box {
      flex: 1; 
      padding: 10px;
      text-align: center;
      color: black;
    }

    .info-box img {
      width: 20%;
    }
    
    .content {
      width: calc(100% - 20px);
      max-width: 1300px; 
      padding: 20px 5rem;
      margin: 0 auto; 
      margin-bottom: 10px;
    }

    .content2 {
      width: calc(100% - 20px);
      max-width: 1000px; 
      padding: 20px 5rem;
      background-color: rgba(255, 255, 255, 0.9); 
      border-radius: 5px;
      box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.8); 
      margin: 0 auto; 
      margin-bottom: 10px;
    }

    .content3 {
      width: calc(100% - 20px);
      max-width: 800px; 
      padding: 40px 5rem;
      background: linear-gradient(to bottom, #f2f2f2, #ffffff); 
      border-radius: 5px;
      box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.8); 
      margin: 0 auto; 
      margin-bottom: 50px;
      margin-top: -20px;
      font-size: 20px;
      color: black;
      text-align: left;
    }

    .cert-wrapper {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
    }

    .cert-links {
      flex: 1;
    }

    .cert-link {
      display: block;
      color: black;
      padding-left: 30px;
      margin-bottom: 10px;
      text-decoration: none;
      background: url('https://cdn-icons-png.flaticon.com/512/845/845646.png') no-repeat left center;
      background-size: 20px;
    }

    .cert-image {
      width: 150px; 
      height: auto;
      object-fit: contain;
    }

    .content-fees {
      width: calc(100% - 20px);
      max-width: 1300px; 
      padding: 20px 1rem;
      background-color: rgba(255, 255, 255, 0.9); 
      border-radius: 5px;
      box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.8); 
      margin: 0 auto; 
      margin-bottom: 10px;
    }

    .content-about {
      width: calc(100% - 20px);
      max-width: 800px; 
      padding: 20px 1rem;
      background-color: rgba(255, 255, 255, 0.9); 
      border-radius: 5px;
      box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.8); 
      margin: 0 auto; 
      margin-bottom: 10px;
    }
    
    .faq {
      background-color: rgba(255, 255, 255, 0.9);
      border-color: rgba(255, 255, 255, 0.8);
      width: 100%;
      margin: 0 auto; 
      max-width: 1000px; 
      background: linear-gradient(90deg, rgba(30, 251, 170, 0.1) 0%, rgba(30, 240, 251, 0.15) 100%);
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.3); 
      backdrop-filter: blur(12px); 
      -webkit-backdrop-filter: blur(12px); 
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25); 
      transition: all 0.3s ease;
      padding: 20px;
    }

    @media (max-width: 1310px) {
      .info-box { flex-basis: 100%; }
      .info-box img { max-width: 100px; }
      .coming-soon img { max-width: 30em; }
      div[style*="display: flex"] { flex-direction: column; }
      .content { padding: 20px 1rem; }
      .content2 { padding: 20px 1rem; }
      nav img { display: none !important; }
      .whmis-carousel { display: none !important; }
      .header { min-width: 42em; }
      .content3 img { display: none !important; }
    }

    * { box-sizing: border-box; }

    .slideshow-container {
      max-width: 900px;
      position: relative;
      margin: 50px auto;
      background: #fff;
      padding: 30px 20px;
      border-radius: 10px;
      box-shadow: 5px 10px 10px rgba(0,0,0,0.6);
    }

    .mySlides { display: none; }
    .review-content { text-align: center; }

    .review-header {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
      margin-bottom: 15px;
    }

    .user-img {
      width: 50px;
      height: 50px;
      border-radius: 50%;
    }

    .stars { font-size: 20px; color: gold; }
    .google-logo { height: 25px; }

    .review-text {
      font-size: 16px;
      line-height: 1.5;
      color: #333;
      margin-top: 10px;
      padding: 0 10px;
    }

    .prev, .next {
      cursor: pointer;
      position: absolute;
      top: 50%;
      width: auto;
      padding: 16px;
      margin-top: -22px;
      font-weight: bold;
      font-size: 22px;
      transition: 0.3s ease;
      user-select: none;
      color: black;
    }

    .next { right: 0; }
    .prev { left: 0; }
    .prev:hover, .next:hover { background-color: rgba(0,0,0,0.1); }

    .text { display: none; } 
    .numbertext {
      color: #999;
      font-size: 12px;
      position: absolute;
      top: 8px;
      left: 16px;
    }

    .dot-container {
      text-align: center;
      margin-top: 15px;
    }

    .dot {
      cursor: pointer;
      height: 12px;
      width: 12px;
      margin: 0 4px;
      background-color: #bbb;
      border-radius: 50%;
      display: inline-block;
      transition: background-color 0.6s ease;
    }

    .active, .dot:hover { background-color: #717171; }

    @keyframes fade {
      from {opacity: .4} 
      to {opacity: 1}
    }

    .fade {
      animation-name: fade;
      animation-duration: 1s;
    }
  </style>

  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="manifest" href="/site.webmanifest" />
</head>